class TCGCard:
    def __init__(
        self,
        name,
        card_type,
        attack=0,
        defense=0,
        cost=0,
        ability="",
        card_class="Neutro",
        attack_style=None,
        energy_generated=0,
        life=0,
        speed="Sorcery",  # "Instant" ou "Sorcery" (para pilha/respostas)
        keywords=None,  # por exemplo: ["Defender"], ["Haste"]
    ):
        self.id = str(uuid.uuid4())
        self.name = name
        self.card_type = card_type  # por exemplo: "Líder","Comum","Especial","Efeito","Energia","Terreno","Item"
        self.attack = attack
        self.defense = defense
        self.cost = cost
        self.ability = ability
        self.card_class = card_class  # string; pode conter vírgulas se for modificada pelo Tomo
        self.attack_style = attack_style
        self.energy_generated = energy_generated
        self.life = life  # apenas para líderes
        self.ja_atacou = False
        self.buff_ataque = 0
        self.buff_defesa = 0
        self.owner = None  # definido quando atribuído a um jogador
        self.summoned_this_turn = False  # enjoo de invocação
        self.speed = speed
        self.keywords = set(keywords or [])

    def atk_total(self):
        base = self.attack + self.buff_ataque
        # Terreno Biblioteca: se o dono tiver "A Grande Biblioteca" em campo e esta carta for Mágico, +1000 ATK
        try:
            if self.owner and "Mágico" in str(self.card_class):
                for c in self.owner.field:
                    if c.card_type == "Terreno" and c.name == "A Grande Biblioteca":
                        base += 1000
                        break
        except Exception:
            pass
        return base

    def def_total(self):
        return self.defense + self.buff_defesa

    def copy_for_deck(self):
        c = copy.deepcopy(self)
        c.id = str(uuid.uuid4())
        c.owner = None
        c.ja_atacou = False
        c.summoned_this_turn = False
        c.buff_ataque = 0
        c.buff_defesa = 0
        return c

    def to_dict(self):
        return {
            "id": self.id,
            "name": self.name,
            "type": self.card_type,
            "atk": self.atk_total(),
            "def": self.def_total(),
            "cost": self.cost,
            "ability": self.ability,
            "class": self.card_class,
            "attack_style": self.attack_style,
            "energy_generated": self.energy_generated,
            "life": self.life,
            "keywords": list(self.keywords),
            "ja_atacou": self.ja_atacou,
            "summoned_this_turn": self.summoned_this_turn,
        }

